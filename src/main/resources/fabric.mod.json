{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "icon": "assets/litematica-printer/icon.png",
  "name": "${mod_name}",
  "description": "An extension for Litematica that adds the missing printer functionality.",
  "authors": [
    "K1nse_"
  ],
  "contact": {
    "website": "${mod_homepage}",
    "homepage": "${mod_sources}",
    "sources": "${mod_sources}"
  },
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "main": [
      "me.K1nse_.litematica.printer.LitematicaPrinterMod"
    ],
    "client": [
      "me.K1nse_.litematica.printer.LitematicaPrinterMod"
    ],
    "modmenu": [
      "me.K1nse_.litematica.printer.config.ModMenu"
    ]
  },
  "mixins": [
    "litematica-printer.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_dependency}",
    "malilib": ">=${malilib}",
    "litematica": ">=${litematica}",
    "fabric-content-registries-v0": "*"
  },
  "custom": {
    "modmenu": {
      "parent": "${mod_wrapper_id}"
    }
  }
}

